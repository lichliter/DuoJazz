{
  "name": "duojazz",
  "private": true,
  "type": "module",
  "description": "A web app for learning jazz licks across all 12 keys.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node tools/dev-server.mjs",
    "start:python": "python3 -m http.server 4173 --bind 127.0.0.1",
    "test": "node --test --test-isolation=none js/*.test.mjs",
    "test:isolated": "node --test js/*.test.mjs",
    "test:exhaustive": "DUOJAZZ_EXHAUSTIVE=1 node --test --test-isolation=none js/*.test.mjs",
    "test:watch": "node --test --watch --test-isolation=none js/*.test.mjs",
    "precache": "node tools/generate-precache.mjs",
    "release": "node tools/bump-assets.mjs",
    "lint": "node tools/check.mjs",
    "verify": "node tools/verify-all.mjs",
    "new-lick": "node tools/new-lick.mjs"
  }
}
